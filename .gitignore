# Python and uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, lint and Jupyter caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data and results stay local (not part of the repository; see docs/MUENSTER_DATA_SOURCES.md)
/data/
/results/
/cache/

# Your own city settings stay local (they hold paths on your computer); only the examples and templates are shared
/config/*.toml
!/config/city_template.toml
!/config/city_template_schema1.toml
!/config/muenster.toml
!/config/muenster_metadata.toml
!/config/synthetic_city.toml

# Workflow workspaces (childcare-access build/solve/compare and the notebooks)
/workspace/

# Demo city raw files (regenerated by examples/synthetic_city/make_city.py)
/examples/synthetic_city/data/

# Large geodata and solver files anywhere (safety net)
*.gpkg
*.pkl
*.zip
*.mps
*.sol
*.mst
*.ilp

# Gurobi licence, logs and node files
*.lic
gurobi.env
gurobi.log
gurobi_nodefiles/

# Credentials and secrets
.env
.env.*
*.pem
*.key
.netrc

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
